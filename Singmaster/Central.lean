theorem centralCerts_length : centralCerts.length = 199 := by
  decide +kernel

theorem centralOK_centralCerts : centralOK 2 centralCerts = true := by
  decide +kernel

/-- For `2 ≤ m ≤ 200`, `C(2m, m)` appears exactly three times in Pascal's triangle. -/
theorem ncard_centralBinom {m : ℕ} (h1 : 2 ≤ m) (h2 : m ≤ 200) :
    (solutions (Nat.centralBinom m)).ncard = 3 :=
  ncard_centralBinom_of_unique h1
    (centralOK_sound centralCerts 2 centralOK_centralCerts m h1
      (by rw [centralCerts_length]; omega))

/-- **Below `C(402, 201)`, a number that appears an odd number of times appears once or
three times** in Pascal's triangle. -/
theorem ncard_eq_one_or_three_of_odd {t : ℕ} (ht : t < Nat.centralBinom 201)
    (hodd : Odd (solutions t).ncard) : (solutions t).ncard = 1 ∨ (solutions t).ncard = 3 := by
  obtain ⟨m, hm1, rfl⟩ := exists_centralBinom_of_odd_ncard hodd
  have hm : m ≤ 200 := by
    by_contra hc
    have := centralBinom_strictMono.monotone (show 201 ≤ m by omega)
    omega
  rcases (show m = 1 ∨ 2 ≤ m by omega) with rfl | hm2
  · left
    rw [show Nat.centralBinom 1 = 2 from rfl, solutions_two, Set.ncard_singleton]
  · exact Or.inr (ncard_centralBinom hm2 hm)

/-- **No number below `C(402, 201)` appears exactly 5 or 7 times** in Pascal's triangle. -/
theorem ncard_ne_five_and_ne_seven {t : ℕ} (ht : t < Nat.centralBinom 201) :
    (solutions t).ncard ≠ 5 ∧ (solutions t).ncard ≠ 7 := by
  refine ⟨fun h => ?_, fun h => ?_⟩
  · have := ncard_eq_one_or_three_of_odd ht (by rw [h]; exact ⟨2, rfl⟩)
    omega
  · have := ncard_eq_one_or_three_of_odd ht (by rw [h]; exact ⟨3, rfl⟩)
    omega

end Singmaster
