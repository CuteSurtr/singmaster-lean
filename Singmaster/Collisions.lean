/-- The Lind–Singmaster number for `i = 4`, `C(4895, 1869) = C(4894, 1870)` (1412 digits),
appears exactly six times in Pascal's triangle. -/
theorem ncard_choose_4895_1869 : (solutions ((4895 : ℕ).choose 1869)).ncard = 6 := by
  rw [choose_4895_1869]
  exact (ncard_eq_of_certOK (S := [(4895, 1869), (4894, 1870)]) (as := cert_4895_1869)
    (by norm_num) (by decide +kernel)).trans (by decide)

/-- The same statement in the form of `Singmaster.choose_fib_eq` with `i = 4`. -/
theorem ncard_solutions_fib_4 :
    (solutions ((fib 10 * fib 11).choose
      (fib 8 * fib 11))).ncard = 6 := by
  have h1 : fib 10 * fib 11 = 4895 := by decide
  have h2 : fib 8 * fib 11 = 1869 := by decide
  rw [h1, h2]
  exact ncard_choose_4895_1869

end Singmaster
